<?xml version="1.0" encoding="utf-8"?>
<!--
  A vector adaptive icon rather than four bitmaps at four densities.

  `minSdk` is 26, which is exactly the introduction of adaptive icons, so there
  is no device in the supported range that needs a raster fallback. That makes
  one small XML file replace roughly 200 KB of PNGs - and app size is a scored
  metric, so those 200 KB are worth having back.

  The monochrome layer is what Android 13+ uses when the user asks for themed
  icons, so the mark follows the system tint instead of ignoring it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
