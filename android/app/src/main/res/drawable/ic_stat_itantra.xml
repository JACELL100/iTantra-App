<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the foreground-service notification.

  Monochrome by contract: Android masks a notification's small icon to a single
  silhouette, so a coloured asset would be flattened into an unrecognisable
  blob. It is also drawn at 24 dp in a 24 dp box with no inset, because the
  system applies its own padding and any inset here would make the glyph sit
  visibly smaller than the icons either side of it.
-->
